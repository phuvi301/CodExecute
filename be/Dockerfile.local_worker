# Local Docker Sandbox for Lambda Worker
# Chạy container cục bộ hỗ trợ đủ 4 ngôn ngữ: Python 3.12, C++17, Java 17, Node.js

FROM python:3.12-slim

# Cài đặt g++, openjdk-17-jdk, nodejs
RUN apt-get update && apt-get install -y \
    g++ \
    make \
    openjdk-17-jdk-headless \
    nodejs \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY lambda_worker.py .

CMD ["python", "lambda_worker.py"]
